<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirección de /evento a Google Apps Script
RewriteRule ^evento/?$ https://script.google.com/macros/s/AKfycbzc2lkUD7qj0E54h5GjGF5FbGscAm5hTaBk7bW9YA9HX5X5eBRuFdi4eBsFwIPImuWE/exec [R=302,L]
</IfModule>

# Respaldo con Redirect directo
Redirect 302 /evento https://script.google.com/macros/s/AKfycbzc2lkUD7qj0E54h5GjGF5FbGscAm5hTaBk7bW9YA9HX5X5eBRuFdi4eBsFwIPImuWE/exec
